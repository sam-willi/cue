{
  "name": "cue",
  "version": "0.1.0",
  "private": true,
  "description": "Cue: real-time speaking-habit cues (fillers, pace, pauses, turn length, volume). Software MVP for a discreet behind-the-ear (BTE) speech coach.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-vad-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-vad-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run --config vitest.eval.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cad": "node scripts/cad-to-glb.mjs",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.31",
    "compromise": "^14.17.0",
    "next": "16.3.8",
    "onnxruntime-web": "^1.30.0",
    "pitchy": "^4.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "occt-import-js": "^0.0.23",
    "prettier": "^3.9.9",
    "retext-equality": "^7.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
