# Optional. Copy to .env.local and paste a Deepgram API key to let the server mint
# short-lived browser tokens. Without it, use "Use your own Deepgram key" in the app.
# The key's role must be Member or higher. Never commit .env.local.
DEEPGRAM_API_KEY=

# Optional. The web app URL of the Google Sheet script that stores landing-page sign-ups
# (README.md, "Landing pages"). Without it, sign-ups are saved to ./signups/ when running locally.
SIGNUPS_SHEET_URL=

# Optional. A Stripe secret key for preorder deposits on /preorder (README.md, "Preorder page").
# Use a test key (sk_test_…) until the account is live. Without it, /preorder holds the price by
# email instead of taking a deposit.
STRIPE_SECRET_KEY=
